# Normaliza los finales de línea: en el repo siempre LF, en el disco lo que toque.
# Sin esto, trabajar en Windows y desplegar en Linux mete diffs de todo el fichero.
* text=auto eol=lf

# Binarios: nunca convertir.
# Los vídeos del montaje de portada se declaran igual que las imágenes. `text=auto` los
# detectaría solo, pero de esto depende que un `git add` en Windows no se ponga a buscar
# saltos de línea en tres megas de VP9.
*.mp4 binary
*.webm binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
