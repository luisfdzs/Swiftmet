# === SWIFTMET — .gitignore ===
# REGLA DE SEGURIDAD (proyecto): NUNCA se sincronizan credenciales, keys, API keys,
# tokens de MCPs ni variables de entorno con GitHub. Cada vez que se añada un secreto
# nuevo o un fichero local de configuración de un desarrollador para una integración,
# hay que incluirlo aquí ANTES de subir nada.

# --- Secretos y variables de entorno ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
secrets.json
service-account*.json
*.secret
*.secrets
*_secret*
*apikey*
*api-key*
*.token
*token*.json

# --- Códigos de recuperación / ficheros sensibles sueltos ---
recovery-codes.txt
*recovery-code*
*recovery-codes*

# --- MCPs con tokens / credenciales ---
.mcp.local.json
mcp.local.json
**/mcp-credentials*.json

# --- Config local de cada desarrollador para integraciones ---
*.local.env
.vscode/*.local.json
.idea/

# --- Contexto de Claude (memoria local de la máquina, no del repo) ---
# Ver la preferencia general: la memoria vive en .claude/memory/ y es local.
.claude/

# --- Dependencias / build ---
node_modules/
dist/
build/
.next/
out/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Sistema operativo ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Next.js / Vercel ---
.vercel
next-env.d.ts
*.tsbuildinfo

# --- Migración a Sanity ---
# Generado por npm run migrate:build a partir de content-snapshot.json.
scripts/migration/import.ndjson

# --- Documentación de origen (fuentes del cliente, no del repo) ---
# El listado de bobinas en PDF es el documento maestro del que salió
# scripts/migration/content-snapshot.json. Se guarda aparte, no en git.
*.pdf
